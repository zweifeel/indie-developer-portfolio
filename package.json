{
  "name": "indie-developer-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --testTimeout=30000",
    "lint": "oxlint",
    "scan": "node scripts/security-scan.js",
    "security:scan": "node scripts/security-scan.js",
    "security:privacy": "node scripts/privacy-scan.js",
    "security:files": "node scripts/check-file-policy.js",
    "security:precommit": "node scripts/pre-commit-check.js",
    "security:prepush": "node scripts/pre-push-check.js",
    "security:test": "vitest run src/test/securityPhase1.test.ts src/test/securityScanner.test.ts",
    "git:status": "node scripts/git-automation/cli.js --mode STATUS --all",
    "git:dry-run": "node scripts/git-automation/cli.js --mode DRY-RUN",
    "git:commit": "node scripts/git-automation/cli.js --mode COMMIT",
    "git:push": "node scripts/git-automation/cli.js --mode PUSH",
    "deploy:live": "npm run build && npx wrangler pages deploy dist --project-name=sleepykoala --branch=main",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
